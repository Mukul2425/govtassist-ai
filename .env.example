# ── Application ──────────────────────────────────────────────
APP_NAME=GovtAssist AI
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://govtassist:govtassist@localhost:5432/govtassist
DATABASE_URL_SYNC=postgresql://govtassist:govtassist@localhost:5432/govtassist

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM (OpenAI-compatible) ────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Set to true to run without LLM API keys (uses rule-based fallbacks)
LLM_MOCK_MODE=false

# ── Security ───────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-64-char-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ───────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Frontend ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
